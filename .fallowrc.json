{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.{js,jsx,mjs}",
    "src/main.{js,jsx,mjs}"
  ],
  "workspaces": {
    "patterns": [
      "apps/*",
      "packages/*"
    ]
  },
  "ignorePatterns": [
    // generated by `pnpm gen:api` — not hand-maintained
    "packages/api-client/src/schema.d.ts",
    // generated by `pnpm gen:api` — not hand-maintained
    "packages/api-client/openapi.json",
    // Drizzle migration output — not hand-maintained
    "packages/db/drizzle/**",
    // Next.js build output — not in fallow's built-in ignore defaults
    "**/.next/**",
    // tracked design-reference bundle outside the pnpm workspace, loaded by the Design Canvas host, not production code
    "Costwise Design System/**",
    // tracked design-reference bundle outside the pnpm workspace, loaded by the Design Canvas host, not production code
    "costwise_revamp/**"
  ],
  "ignoreDependencies": [
    // loaded as a string via FlatCompat (apps/web/eslint.config.mjs), invisible to the module graph
    "eslint-config-next"
  ]
}
