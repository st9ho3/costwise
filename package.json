{
  "name": "costwise",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "dotenv -c -- turbo run dev",
    "build": "dotenv -c -- turbo run build",
    "start": "dotenv -c -- turbo run start",
    "lint": "turbo run lint",
    "test": "dotenv -c -- turbo run test",
    "gen:api": "pnpm --filter api emit-openapi && pnpm --filter @costwise/api-client gen",
    "fallow": "fallow",
    "fallow:ci": "fallow --quiet"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "fallow": "3.17.0",
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "sharp",
      "@tailwindcss/oxide",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
