{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "BLOB_READ_WRITE_TOKEN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "NEXT_PUBLIC_API_URL",
    "WEB_ORIGIN",
    "NEXT_PUBLIC_WEB_ORIGIN",
    "AUTH_DEBUG",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "start": { "cache": false, "persistent": true },
    "lint": {},
    "test": { "cache": false }
  }
}
