      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|sunken|brand|accent|flat)$/]",
        "message": "<Card> variant must be one of 'default' | 'sunken' | 'brand' | 'accent' | 'flat'."
